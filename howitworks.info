Step 1: Define Your Format Constants & Safety Wrappers
Always establish strict boundaries for file layouts, magic numbers, and automatic backup routines before implementing parsers.
import shutil
import time
from pathlib import Path

def backup_file(path: Path) -> Path:
    """Always protect user game files before writing."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup = path.with_name(f"{path.name}.backup-{stamp}")
    shutil.copy2(path, backup)
    return backup

